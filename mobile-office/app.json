{
  "expo": {
    "name": "Hakan Ofis",
    "slug": "hakan-ofis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hakanofis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hakan.office",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hakan.office",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2448FF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mükellefin vergi levhasının fotoğrafını çekip bilgilerini okumak için kamera kullanılır.",
          "photosPermission": "Galerideki vergi levhası fotoğrafını seçip bilgilerini okumak için kullanılır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2448FF"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

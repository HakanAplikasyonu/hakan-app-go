{
  "expo": {
    "name": "Hakan",
    "slug": "hakan-mukellef",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hakan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hakan.mukellef",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hakan.mukellef",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Fiş ve Z raporu fotoğrafı çekip müşavirinize göndermek için kamera kullanılır.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fiş ve Z raporu fotoğrafı çekip müşavirinize göndermek için kamera kullanılır.",
          "photosPermission": "Galerideki fiş fotoğraflarını seçip müşavirinize göndermek için kullanılır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2448FF"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
